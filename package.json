{
  "name": "songfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF --schema public > src/db/types.ts",
    "smoke": "node --env-file=.env.local --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.52.0",
    "@supabase/ssr": "~0.5.2",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "15",
    "openai": "^4.104.0",
    "p-limit": "^6.2.0",
    "react": "19",
    "react-dom": "19",
    "server-only": "0.0.1",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "autoprefixer": "^10.6.1",
    "eslint": "9",
    "eslint-config-next": "15",
    "postcss": "^8.4.31",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "supabase",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
