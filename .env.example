# Songfit environment. Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# Project ref is the subdomain of the project URL. DB password is the one chosen at project creation.
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=...

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Stripe (Wednesday) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/...
STRIPE_PRICE_ID=price_...
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/...

# --- App ---
# Comma-separated, case-insensitive. Gates /admin.
ADMIN_EMAILS=dylanbryan2002@gmail.com
# Random secret the submit route uses to trigger the pipeline route. Generate with: openssl rand -hex 32
INTERNAL_TOKEN=replace-with-64-hex-chars
# Public origin of the deployed app (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apple Music API (MusicKit developer token). Dylan enters these; see README "Apple Music".
# Locally the easiest is the path to the .p8 file. In Vercel paste the file's text as
# APPLE_MUSICKIT_PRIVATE_KEY (multi-line is fine there). APPLE_MUSICKIT_PRIVATE_KEY_B64 (one-line base64) also works.
APPLE_MUSICKIT_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=YOUR-TEAM-ID
APPLE_MUSICKIT_KEY_ID=YOUR-KEY-ID
APPLE_MUSICKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# ACRCloud music recognition, ground-truth eval only (scripts/groundtruth/fingerprint.ts; docs/review/18). Trial keys from console.acrcloud.com.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
